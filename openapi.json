    "/api/recommendation/beaches": {
      "get": {
        "tags": [
          "Beach Recommendation"
        ],
        "summary": "Get Beach Recommendations",
        "description": "Mengembalikan daftar rekomendasi pantai tersehat di Banten, diurutkan berdasarkan Health Score tertinggi.\n\nHealth Score dihitung dari kombinasi multi-parameter:\n- 30% Persentase area air sehat (Pct_Sehat_2026)\n- 20% Kejernihan air (1 - NDTI, inverted)\n- 10% Kadar klorofil-a (1 - NDCI, inverted)\n- 10% Kandungan padatan tersuspensi (1 - TSS, inverted)\n- 5%  Bahan organik terlarut (1 - CDOM, inverted)\n- 15% Tren kualitas historis (MEMBAIK > STABIL > MEMBURUK)\n- 10% Dampak industri terdekat (RENDAH > SEDANG > TINGGI)",
        "operationId": "get_beach_recommendations_api_recommendation_beaches_get",
        "parameters": [
          {
            "name": "top_n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Jumlah pantai teratas. Kosongkan untuk semua.",
              "title": "Top N"
            },
            "description": "Jumlah pantai teratas. Kosongkan untuk semua."
          },
          {
            "name": "min_score",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100,
              "minimum": 0,
              "description": "Filter: Health Score minimum.",
              "title": "Min Score"
            },
            "description": "Filter: Health Score minimum."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
